{
    "name": "crypto-price-ticker",
    "displayName": "Crypto Price Ticker",
    "description": "Keep an eye on cryptocurrency prices as you code!",
    "keywords": [
        "bitcoin",
        "ethereum",
        "price",
        "crypto"
    ],
    "version": "1.4.0",
    "publisher": "Mavis2103",
    "repository": {
        "type": "git",
        "url": "https://github.com/Mavis2103/Crypto-Tricker"
    },
    "license": "MIT",
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        }
    },
    "contributes": {
        "commands": [
            {
                "command": "crypto-price-ticker.toggle",
                "title": "Toggle Crypto Price Ticker",
                "icon": "$(pulse)"
            },
            {
                "command": "crypto-price-ticker.setApiKeys",
                "title": "Set API Keys",
                "icon": "$(key)"
            },
            {
                "command": "crypto-price-ticker.clearApiKeys",
                "title": "Clear API Keys",
                "icon": "$(trash)"
            },
            {
                "command": "crypto-price-ticker.showChart",
                "title": "Show K-line Chart",
                "icon": "$(graph-line)"
            }
        ],
        "keybindings": [
            {
                "command": "crypto-price-ticker.showChart",
                "key": "ctrl+alt+k"
            }
        ],
        "viewsContainers": {
            "panel": [
                {
                    "id": "cryptoPanel",
                    "title": "Crypto",
                    "icon": "$(graph-line)"
                }
            ]
        },
        "views": {
            "cryptoPanel": [
                {
                    "id": "crypto.kline",
                    "name": "K-line",
                    "type": "webview"
                }
            ]
        },
        "configuration": [
            {
                "title": "Crypto Price Ticker",
                "properties": {
                    "crypto-price-ticker.interval": {
                        "type": "number",
                        "default": 60,
                        "description": "The refresh interval in seconds."
                    },
                    "crypto-price-ticker.onlyRefreshWhenFocused": {
                        "type": "boolean",
                        "default": false,
                        "description": "Disable refreshing when the vscode window does not have focus."
                    },
                    "crypto-price-ticker.higherColor": {
                        "type": "string",
                        "default": "lightgreen",
                        "description": "The color that indicates the symbol is trading higher. Also used for up candles on the K-line chart."
                    },
                    "crypto-price-ticker.lowerColor": {
                        "type": "string",
                        "default": "coral",
                        "description": "The color that indicates the symbol is trading lower. Also used for down candles on the K-line chart."
                    },
                    "crypto-price-ticker.tickers": {
                        "type": "array",
                        "scope": "application",
                        "items": {
                            "type": "object",
                            "properties": {
                                "symbol": {
                                    "type": "string",
                                    "description": "The symbol to display."
                                },
                                "currency": {
                                    "type": "string",
                                    "default": "USDT",
                                    "description": "The currency to display the price in."
                                },
                                "exchange": {
                                    "type": "string",
                                    "description": "The exchange to get the price from."
                                },
                                "template": {
                                    "type": "string",
                                    "default": "{symbol}{market} {price}",
                                    "description": "The template to use to display the ticker."
                                },
                                "provider": {
                                    "type": "string",
                                    "default": "Binance",
                                    "enum": [
                                        "Binance",
                                        "OKX"
                                    ],
                                    "description": "The provider to use to get the price."
                                },
                                "market": {
                                    "type": "string",
                                    "default": "spot",
                                    "enum": [
                                        "spot",
                                        "futures",
                                        "swap"
                                    ],
                                    "description": "The market to fetch. Binance supports spot and futures, OKX supports spot and swap (perpetual). Unsupported combinations fall back to spot."
                                }
                            },
                            "required": [
                                "symbol"
                            ]
                        },
                        "default": [
                            {
                                "symbol": "BTC",
                                "currency": "USDT",
                                "provider": "Binance"
                            },
                            {
                                "symbol": "ETH",
                                "currency": "USDT",
                                "provider": "Binance"
                            }
                        ],
                        "description": "The array of ticker definitions to display in the status bar."
                    },
                    "crypto-price-ticker.providers": {
                        "type": "object",
                        "scope": "application",
                        "properties": {
                            "binance": {
                                "type": "object",
                                "properties": {
                                    "apiKey": {
                                        "type": "string",
                                        "default": "",
                                        "description": "API key for Binance provider."
                                    },
                                    "secretKey": {
                                        "type": "string",
                                        "default": "",
                                        "description": "Secret key for Binance provider."
                                    }
                                },
                                "default": {
                                    "apiKey": "",
                                    "secretKey": ""
                                },
                                "description": "Configuration for Binance provider."
                            },
                            "okx": {
                                "type": "object",
                                "properties": {
                                    "apiKey": {
                                        "type": "string",
                                        "default": "",
                                        "description": "API key for OKX provider."
                                    },
                                    "secretKey": {
                                        "type": "string",
                                        "default": "",
                                        "description": "Secret key for OKX provider."
                                    }
                                },
                                "default": {
                                    "apiKey": "",
                                    "secretKey": ""
                                },
                                "description": "Configuration for OKX provider."
                            }
                        },
                        "default": {
                            "binance": {
                                "apiKey": "",
                                "secretKey": ""
                            },
                            "okx": {
                                "apiKey": "",
                                "secretKey": ""
                            }
                        },
                        "description": "Deprecated: use the 'Set API Keys' command instead. Keys stored here are visible in settings files and may be committed to version control."
                    }
                }
            },
            {
                "title": "K-line Chart",
                "properties": {
                    "crypto-price-ticker.chartScale": {
                        "type": "number",
                        "default": 100,
                        "minimum": 40,
                        "maximum": 100,
                        "description": "Size of the K-line chart as a percentage of the panel. Width and height scale together so the candles are not squashed. 100 fills the panel."
                    },
                    "crypto-price-ticker.chartTicker": {
                        "type": "string",
                        "default": "",
                        "markdownDescription": "Which configured ticker the K-line chart follows. Match by symbol (`ETH`), pair (`ETH/USDT`), or pair + provider + market (`BTC/USDC Binance futures`). Leave empty to follow the first entry of `crypto-price-ticker.tickers`.",
                        "description": "Which configured ticker the K-line chart follows. Leave empty to follow the first entry of crypto-price-ticker.tickers. Examples: ETH, ETH/USDT, BTC/USDC Binance futures."
                    },
                    "crypto-price-ticker.chartInterval": {
                        "type": "string",
                        "default": "1m",
                        "enum": [
                            "1m",
                            "5m",
                            "15m",
                            "1h",
                            "4h",
                            "1d"
                        ],
                        "description": "The candle interval of the K-line chart."
                    },
                    "crypto-price-ticker.chartCandles": {
                        "type": "number",
                        "default": 60,
                        "minimum": 10,
                        "maximum": 300,
                        "description": "How many candles the K-line chart draws. OKX caps a single request at 300."
                    },
                    "crypto-price-ticker.chartRefreshSeconds": {
                        "type": "number",
                        "default": 15,
                        "minimum": 5,
                        "maximum": 600,
                        "description": "How often the K-line chart refreshes while its tab is visible. The chart stops polling entirely when the tab is hidden or closed."
                    }
                }
            }
        ]
    },
    "scripts": {
        "build": "vsce package",
        "publish": "vsce publish",
        "vscode:prepublish": "bun run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^10.12.21",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^5.12.0",
        "@typescript-eslint/parser": "^5.12.0",
        "typescript": "^4.5.5",
        "eslint": "^8.9.0"
    },
    "dependencies": {
        "got": "^11.8.3",
        "vsce": "^2.15.0"
    }
}
